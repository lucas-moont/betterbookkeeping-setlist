generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  password  String
  workouts  Workout[]
  movements Movement[]
}

// Every Movement belongs to one user (ADR 0001). nameKey is the name trimmed and lower-cased, so
// names are unique per user ignoring case. The code sets it on every write to name.
model Movement {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  nameKey   String
  createdAt DateTime @default(now())
  sets      Set[]

  @@unique([userId, nameKey])
}

model Workout {
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  id          String    @id @default(uuid())
  completedAt DateTime?
  sets        Set[]
}

model Set {
  id         String   @id @default(uuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  movementId String
  movement   Movement @relation(fields: [movementId], references: [id])
  reps       Int
  weight     Int
}
