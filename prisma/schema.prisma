generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  password          String
  workouts          Workout[]
  movements         Movement[]
  bodyWeightEntries BodyWeightEntry[]
}

// Every Movement belongs to one user (ADR 0001). nameKey is the name trimmed and lower-cased, so
// names are unique per user ignoring case. The code sets it on every write to name.
model Movement {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  name         String
  nameKey      String
  // Optional: a Movement without one counts toward no Workout's Muscle Groups (ADR 0011).
  muscleGroup  MuscleGroup?
  // A Body-weight Movement (CONTEXT.md). Changing it only affects Sets logged afterwards (ADR 0003).
  isBodyWeight Boolean      @default(false)
  createdAt    DateTime     @default(now())
  sets         Set[]

  @@unique([userId, nameKey])
}

// The fixed list, in the order a Workout's Muscle Groups are shown (ADR 0011). Adding one later
// takes an ALTER TYPE ... ADD VALUE migration. src/lib/movements/muscle-group.ts mirrors it.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  ABS
  LOWER_BACK
}

model Workout {
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  id          String    @id @default(uuid())
  // NULL only on Workouts from before it existed, read as "unknown" (ADR 0007). Every new one has it.
  startedAt   DateTime?
  completedAt DateTime?
  sets        Set[]
  // A user has at most one Current Workout, through a partial unique index on userId where
  // completedAt is NULL. Prisma can't express it, so it only exists in the one_current_workout
  // migration (ADR 0006).

  // The history reads a user's Completed Workouts by completedAt.
  @@index([userId, completedAt])
}

model Set {
  id              String    @id @default(uuid())
  workoutId       String
  workout         Workout   @relation(fields: [workoutId], references: [id])
  movementId      String
  movement        Movement  @relation(fields: [movementId], references: [id])
  reps            Int
  weight          Decimal   @db.Decimal(6, 2)
  // Fixed when the Set is created, from its Movement's flag at that moment: it decides whether the
  // Set takes a Body Weight Snapshot, never the Movement's current flag (ADR 0003).
  isBodyWeight    Boolean   @default(false)
  // Signed: positive is extra load, negative is assistance. Only on body-weight Sets, always with a
  // note, and never below -weight, so Load is never negative. CHECK constraints in the
  // set_body_weight_and_added_weight migration enforce all three (ADR 0003).
  addedWeight     Decimal?  @db.Decimal(6, 2)
  addedWeightNote String?   @db.VarChar(60)
  // Sets are listed by createdAt, then id (ADR 0007). Legacy sets got the migration time.
  createdAt       DateTime  @default(now())
  // When the Set was completed; NULL makes it a Planned Set, which counts toward nothing (ADR 0011).
  completedAt     DateTime?

  @@index([workoutId])
  @@index([movementId])
}

// The lifter's body weight on one calendar date (CONTEXT.md). At most one per user per date:
// recording the same date again replaces the weight. date is a Postgres date with no time of day,
// so it crosses the server-function boundary as "YYYY-MM-DD" text (ADR 0004).
model BodyWeightEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  weight    Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
